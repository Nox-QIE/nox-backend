{
  "name": "nox-backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "bot"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p bot --noEmit",
    "dev:bot": "npm run dev -w @nox/bot",
    "dev:chain": "node --import tsx bot/scripts/dev-chain.ts",
    "sim:game": "node --env-file=.env --import tsx bot/scripts/sim-game.ts",
    "indexer": "node --env-file=.env --import tsx bot/scripts/indexer.ts",
    "gas:report": "node --env-file=.env --import tsx bot/scripts/gas-report.ts",
    "report": "node --env-file=.env --import tsx bot/scripts/report.ts",
    "backup": "node --env-file=.env --import tsx bot/scripts/backup.ts",
    "ops:report": "node --env-file=.env --import tsx bot/scripts/ops-report.ts",
    "reconcile:txs": "node --env-file=.env --import tsx bot/scripts/reconcile-txs.ts",
    "content:lock": "node --import tsx bot/scripts/content-lock.ts",
    "wallet:audit": "node --import tsx bot/scripts/wallet-audit.ts",
    "gamenight": "node --import tsx bot/scripts/gamenight.ts"
  },
  "devDependencies": {
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
