# Token from @BotFather. Never commit the real value.
BOT_TOKEN=

# Optional phase lengths in seconds (defaults: 120 / 60 / 90 / 45).
LOBBY_SECONDS=
NIGHT_SECONDS=
DISCUSSION_SECONDS=
VOTE_SECONDS=

# AI Game Master. "template" (default) needs no network.
NOX_GM=template
# Model pool: comma-separated provider:model[@weight]. Each game picks one by weight (variety
# between games, one voice inside a game); the others are failover. Overrides the two lines below.
#   e.g. oxion:claude-opus-5.5@2,oxion:claude-sonnet-5,anthropic:claude-opus-5-5
# Fill it automatically from both providers' model lists: bot/scripts/gm-discover.ts
NOX_GM_MODELS=
# How many models gm-discover keeps (default 10).
NOX_GM_DISCOVER_TOTAL=
# Single model (used when NOX_GM_MODELS is empty).
# "anthropic" = Claude API (ANTHROPIC_API_KEY or `ant auth login`), "oxion" = Oxion AI gateway.
NOX_GM_PROVIDER=anthropic
NOX_GM_MODEL=claude-opus-5-5
NOX_GM_TIMEOUT_SECONDS=8
# Anthropic (Claude API) key for anthropic: entries, sk-ant-…
ANTHROPIC_API_KEY=

# Oxion only: cc_… key. Base URL defaults to https://oxionai.com (a trailing /v1 is fine).
# Oxion model IDs use dots, e.g. claude-opus-5.5 (list them with GET https://oxionai.com/v1/models).
OXION_API_KEY=
NOX_GM_BASE_URL=
# Optional USD per million tokens "input,output" when the provider's rates differ, e.g. 4,20.
NOX_GM_PRICE_PER_M=

# Public dashboard (nox-frontend) for proof links at game end, e.g. https://nox.example
NOX_WEB_URL=

# Webhook mode (for a server). Leave NOX_WEBHOOK_URL empty for long polling (local development).
# The bot listens on NOX_WEBHOOK_HOST:NOX_WEBHOOK_PORT (default 127.0.0.1:8080, behind an https reverse
# proxy) at /telegram/webhook; Telegram must send NOX_WEBHOOK_SECRET back (openssl rand -hex 32).
NOX_WEBHOOK_URL=
NOX_WEBHOOK_SECRET=
NOX_WEBHOOK_PORT=
NOX_WEBHOOK_HOST=

# Per-user limit on commands, button taps and private messages: "updates/seconds" (default 20/10).
NOX_RATE_LIMIT=

# "required": themes, Marketplace Game Masters and lobbies over 8 players need the host's Host Pass
# (NoxPayments, needs NOX_CHAIN and NOX_PAYMENTS_ADDRESS). Default "off".
NOX_HOST_PASS=

# Nudge a quiet discussion halfway: "quiet" (default; works only with Telegram group privacy
# mode disabled in BotFather, so the bot can count messages), "always" (once per discussion) or "off".
NOX_DISCUSSION_NUDGE=

# Offer the extended role set (Hunter, Cupid, Witch) in lobbies: "on" or "off". Default: on without a chain,
# off with one, because NoxGame must accept the new role codes (nox-contracts#20, #22) before games can finalize.
NOX_EXTENDED_ROLES=

# The indexer's public API (npm run indexer), for player stats when a player presses Start again.
NOX_API_URL=

# NoxBadges (achievement badges such as Scam Spotter), optional; also read by the indexer.
NOX_BADGES_ADDRESS=

# Telegram user id that gets incident alerts (disputed games) by DM; it must have pressed Start.
NOX_OPERATOR_CHAT_ID=

# Alert the operator (log + DM) when its wallet holds less than this many QIE (default 0.5).
NOX_TREASURY_ALERT=

# SQLite file for started users and encrypted game secrets (default data/nox.db).
NOX_DB_PATH=

# ---- Chain (NoxGame on QIE). "off" = play without blockchain.
# off | local (anvil) | testnet (QIE 1983) | mainnet (QIE 1990)
NOX_CHAIN=off
# Optional RPC override (testnet default rpc2testnet, mainnet default rpc1mainnet, local 127.0.0.1:8545)
NOX_RPC_URL=
# Deployed NoxGame address
NOX_GAME_ADDRESS=
# Operator private key (0x + 64 hex). Holds QIE for gas drips and operator calls.
NOX_OPERATOR_KEY=
# Secret all player wallets are derived from (openssl rand -hex 32). Never change it after launch.
NOX_WALLET_SECRET=
# Gas drip in QIE: top a player up to DRIP when below MIN
NOX_GAS_DRIP=0.002
NOX_GAS_MIN=0.0005
# Agent Marketplace contracts (operator scripts: agents.ts register, settle-agents.ts)
NOX_AGENT_REGISTRY_ADDRESS=
NOX_PAYMENTS_ADDRESS=
# Block NoxPayments was deployed at (payment events are read from here)
NOX_PAYMENTS_FROM_BLOCK=0
# Daily caps in QIE (abuse guard): per player, and for all players together
NOX_GAS_DAILY_PER_PLAYER=0.01
NOX_GAS_DAILY_BUDGET=5

# Indexer + public API (npm run indexer). Read-only: no keys needed.
NOX_INDEX_FROM_BLOCK=
NOX_INDEX_CONFIRMATIONS=2
NOX_INDEX_DB_PATH=
# Minutes between credits reconciliations against NoxCredits.balanceOf (default 60, "off" to disable).
NOX_RECONCILE_MINUTES=
NOX_API_PORT=8787
NOX_API_HOST=127.0.0.1
