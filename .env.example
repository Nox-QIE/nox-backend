# Token from @BotFather. Never commit the real value.
BOT_TOKEN=

# Optional phase lengths in seconds (defaults: 120 / 60 / 90 / 45).
LOBBY_SECONDS=
NIGHT_SECONDS=
DISCUSSION_SECONDS=
VOTE_SECONDS=

# AI Game Master. "template" (default) needs no network.
NOX_GM=template
# Model pool: comma-separated provider:model[@weight]. Each game picks one by weight (variety
# between games, one voice inside a game); the others are failover. Overrides the two lines below.
#   e.g. oxion:claude-opus-5.5@2,oxion:claude-sonnet-5,anthropic:claude-opus-5-5
NOX_GM_MODELS=
# Single model (used when NOX_GM_MODELS is empty).
# "anthropic" = Claude API (ANTHROPIC_API_KEY or `ant auth login`), "oxion" = Oxion AI gateway.
NOX_GM_PROVIDER=anthropic
NOX_GM_MODEL=claude-opus-5-5
NOX_GM_TIMEOUT_SECONDS=8
# Oxion only: cc_… key. Base URL defaults to https://oxionai.com (a trailing /v1 is fine).
# Oxion model IDs use dots, e.g. claude-opus-5.5 (list them with GET https://oxionai.com/v1/models).
OXION_API_KEY=
NOX_GM_BASE_URL=
# Optional USD per million tokens "input,output" when the provider's rates differ, e.g. 4,20.
NOX_GM_PRICE_PER_M=
